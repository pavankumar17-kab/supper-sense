{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supper-sense-household",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supper-sense-household",
      "database_id": "b18c3fd5-be35-4c3c-b4c9-887efb4f310b",
      "migrations_dir": "migrations"
    }
  ]
}
